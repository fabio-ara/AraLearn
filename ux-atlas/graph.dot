  "study-unit" -> "study-sources" [label="2 · ⌑ Fontes"];
  "study-unit" -> "study-review" [label="3 · ★ Marcar para rever", style=dashed];
  "study-unit" -> "study-observation" [label="4 · ◌ Observação"];
  "study-unit" -> "study-edit" [label="5 · ✎ Editar"];
  "study-practice" -> "study-unit" [label="1 · Continuar → próxima Unidade", style=dashed];
  "study-sources" -> "study-unit" [label="1 · ← Fechar / voltar"];
  "study-review" -> "study-unit" [label="1 · Abrir Unidade"];
  "study-observation" -> "study-unit" [label="1 · ← Voltar"];
  "study-edit" -> "study-provider" [label="1 · Assistência por API"];
  "study-edit" -> "study-copy" [label="2 · Salvar (Curso compartilhado)", style=dashed];
  "study-edit" -> "study-unit" [label="3 · Salvar (Curso próprio)", style=dashed];
  "study-provider" -> "study-edit" [label="1 · Aplicar ao rascunho"];
  "study-copy" -> "study-unit" [label="1 · Salvar na minha cópia"];
  "author-home" -> "author-create" [label="1 · ＋ Criar Curso"];
  "author-home" -> "author-course" [label="2 · Abrir Curso"];
  "author-create" -> "author-course" [label="1 · Criar Curso"];
  "author-course" -> "author-plan" [label="1 · Planejamento e Partes"];
  "author-course" -> "author-inspection" [label="2 · Conteúdo / Inspeção"];
  "author-course" -> "author-parameters" [label="3 · Parâmetros e orientação"];
  "author-course" -> "author-sources" [label="4 · Fontes"];
  "author-course" -> "author-observations" [label="5 · Revisar"];
  "author-course" -> "author-variants" [label="6 · Variantes"];
  "author-course" -> "author-research" [label="7 · Pesquisa"];
  "author-course" -> "author-people" [label="8 · Pessoas"];
  "author-plan" -> "author-part" [label="1 · Abrir Parte"];
  "author-plan" -> "mcp-composer" [label="2 · ChatGPT"];
  "author-plan" -> "author-materialization" [label="3 · Produzir"];
  "author-part" -> "author-parameters" [label="1 · Desenho"];
  "author-part" -> "author-sources" [label="2 · Fontes"];
  "author-part" -> "author-materialization" [label="3 · Produzir / Retomar"];
  "author-part" -> "mcp-composer" [label="4 · Preparar pedido para ChatGPT"];
  "author-parameters" -> "parameter-1" [label="1 · Abrir parâmetro 1", style=dashed];
  "author-parameters" -> "parameter-2" [label="2 · Abrir parâmetro 2", style=dashed];
  "author-parameters" -> "parameter-3" [label="3 · Abrir parâmetro 3", style=dashed];
  "author-parameters" -> "parameter-4" [label="4 · Abrir parâmetro 4", style=dashed];
  "author-parameters" -> "author-guidance" [label="5 · Orientação autoral"];
  "author-parameters" -> "author-components" [label="6 · Política de componentes"];
  "parameter-1" -> "author-parameters" [label="1 · ← Voltar"];
  "parameter-2" -> "author-parameters" [label="1 · ← Voltar"];
  "parameter-3" -> "author-parameters" [label="1 · ← Voltar"];
  "parameter-4" -> "author-parameters" [label="1 · ← Voltar"];
  "author-guidance" -> "author-parameters" [label="1 · ← Voltar"];
  "author-components" -> "author-parameters" [label="1 · ← Voltar"];
  "author-sources" -> "author-source-detail" [label="1 · Abrir Fonte"];
  "author-source-detail" -> "author-sources" [label="1 · ← Voltar"];
  "author-structure" -> "author-inspection" [label="1 · Conferir Unidades", style=dashed];
  "author-materialization" -> "author-inspection" [label="1 · Conferir conteúdo confirmado"];
  "author-inspection" -> "study-edit" [label="1 · ✎ Editar (mesmo editor)"];
  "author-inspection" -> "study-provider" [label="2 · ✦ Assistência por API"];
  "author-inspection" -> "author-observations" [label="3 · ◌ Anotar"];
  "author-inspection" -> "author-sources" [label="4 · ⌑ Definir fontes"];
  "author-inspection" -> "author-audit" [label="5 · ✓ Auditar"];
  "author-observations" -> "author-audit" [label="1 · Corrigir conteúdo → Auditar", style=dashed];
  "author-audit" -> "author-inspection" [label="1 · Conferir resultado"];
  "author-research" -> "author-inspection" [label="1 · Deep link para objeto", style=dashed];
  "mcp-composer" -> "mcp-connect" [label="1 · Autorizar (se necessário)", style=dashed];
  "mcp-composer" -> "mcp-tools" [label="2 · Copiar pedido → cliente MCP", style=dashed];
  "mcp-connect" -> "mcp-tools" [label="1 · OAuth concluído"];
  "mcp-tools" -> "mcp-plan" [label="1 · listarCursos / lerCurso", style=dashed];
  "mcp-plan" -> "mcp-materialize" [label="1 · Contexto suficiente", style=dashed];
  "mcp-materialize" -> "mcp-step" [label="1 · Produzir próxima etapa"];
  "mcp-step" -> "mcp-step" [label="1 · Próxima Microssequência"];
  "mcp-step" -> "mcp-return" [label="2 · Validação final concluída", style=dashed];
  "mcp-return" -> "author-inspection" [label="1 · Conferir em Inspeção"];
  "mcp-return" -> "author-parameters" [label="2 · Parâmetros aplicados"];
  "mcp-return" -> "author-sources" [label="3 · Fontes"];
  "mcp-return" -> "author-audit" [label="4 · Revisar / Auditar"];
