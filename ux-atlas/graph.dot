digraph Atlas {
  graph [rankdir=TB, compound=true, newrank=true, bgcolor="transparent", pad=0.24, nodesep=0.34, ranksep=0.62, splines=spline, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#c8cdd5", penwidth=1.1, fontname="Arial", fontsize=10.5, margin="0.14,0.10"];
  edge [color="#a5abb4", fontcolor="#606873", penwidth=1.0, arrowsize=0.7, fontname="Arial", fontsize=8.5];
  subgraph cluster_entrada {
    id="cluster-entrada"; label="Entrada"; style="rounded"; color="#d9dde3";
    "login" [id="screen-login", label="1. Entrar"];
    "signup" [id="screen-signup", label="2. Criar conta"];
    "recover" [id="screen-recover", label="3. Pedir recuperação"];
    "newpass" [id="screen-newpass", label="4. Definir nova senha"];
  }
  subgraph cluster_estudo {
    id="cluster-estudo"; label="Estudo"; style="rounded"; color="#d9dde3";
    "study-home" [label="1. Escolher um Curso"];
    "study-hierarchy" [label="2. Navegar pelo Curso"];
    "study-unit" [label="3. Estudar uma Unidade"];
    "study-practice" [label="4. Responder a uma prática"];
    "study-sources" [label="5. Consultar Fontes"];
    "study-review" [label="6. Marcar e rever"];
    "study-observation" [label="7. Registrar uma Observação"];
    "study-edit" [label="8. Editar manualmente"];
    "study-provider" [label="9. Pedir ajuda a um modelo"];
    "study-copy" [label="10. Salvar em uma cópia pessoal"];
  }
  subgraph cluster_autoria {
    id="cluster-autoria"; label="Autoria"; style="rounded"; color="#d9dde3";
    "author-home" [label="1. Abrir a Autoria"];
    "author-create" [label="2. Criar um Curso"];
    "author-course" [label="3. Trabalhar no Curso"];
    "author-plan" [label="4. Planejar e organizar Partes"];
    "author-part" [label="5. Trabalhar numa Parte"];
    "author-parameters" [label="6. Ver o desenho efetivo"];
    "parameter-1" [label="7. Parâmetro 1 — granularidade"];
    "parameter-2" [label="8. Parâmetro 2 — formas de explicação"];
    "parameter-3" [label="9. Parâmetro 3 — oportunidades de prática"];
    "parameter-4" [label="10. Parâmetro 4 — variação da prática"];
    "author-guidance" [label="11. Dar orientação autoral"];
    "author-components" [label="12. Definir política de componentes"];
    "author-sources" [label="13. Organizar Fontes"];
    "author-source-detail" [label="14. Ancorar e atribuir uma Fonte"];
    "author-structure" [label="15. Conferir a estrutura"];
    "author-materialization" [label="16. Produzir ou retomar uma Parte"];
    "author-inspection" [label="17. Conferir o conteúdo produzido"];
    "author-observations" [label="18. Tratar Observações"];
    "author-audit" [label="19. Auditar, corrigir e verificar"];
    "author-variants" [label="20. Criar variantes comparáveis"];
    "author-research" [label="21. Examinar fatos de Autoria"];
    "author-people" [label="22. Conceder acesso ao Estudo"];
  }
  subgraph cluster_mcp {
    id="cluster-mcp"; label="ChatGPT / MCP"; style="rounded"; color="#d9dde3";
    "mcp-composer" [label="1. Preparar um pedido no AraLearn"];
    "mcp-connect" [label="2. Autorizar o cliente MCP"];
    "mcp-tools" [label="3. Entender as cinco ferramentas"];
    "mcp-plan" [label="4. Ler o contexto antes de produzir"];
    "mcp-materialize" [label="5. Iniciar a materialização"];
    "mcp-step" [label="6. Produzir e confirmar cada etapa"];
    "mcp-return" [label="7. Voltar ao AraLearn e conferir"];
  }
  subgraph cluster_conta {
    id="cluster-conta"; label="Conta"; style="rounded"; color="#d9dde3";
    "settings" [label="1. Conta e aparência"];
  }

  "login" -> "signup" [label="1 · ＋ Criar conta"];
  "login" -> "study-home" [label="2 · → Entrar"];
  "login" -> "recover" [label="3 · ⌕ Recuperar senha"];
  "signup" -> "login" [label="1 · ← Voltar"];
  "signup" -> "study-home" [label="2 · ＋ Criar conta (se houver sessão)", style=dashed];
  "recover" -> "login" [label="1 · ← Voltar"];
  "recover" -> "newpass" [label="2 · ✉ Link recebido por e-mail", style=dashed];
  "newpass" -> "study-home" [label="1 · ✓ Salvar nova senha"];
  "study-home" -> "study-hierarchy" [label="1 · Começar / Continuar / Retomar"];
  "study-home" -> "study-review" [label="2 · Rever"];
  "study-home" -> "author-home" [label="3 · ✎ Autoria"];
