digraph G {
  graph [rankdir=LR,bgcolor="transparent",pad=.25,nodesep=.55,ranksep=.8,splines=spline]
  node [shape=rect,style="rounded,filled",fillcolor="#ffffff",color="#cfd5df",penwidth=1.2,fontname="Arial",fontsize=12,margin=".18,.12"]
  edge [color="#667085",penwidth=1.25,arrowsize=.7,fontname="Arial",fontsize=10,fontcolor="#344054"]
  login [label="Entrar"]
  signup [label="Criar conta"]
  recover [label="Recuperar acesso"]
  newpass [label="Nova senha"]
  library [label="Cursos"]
  login -> library [label="1"]
  login -> signup [label="2"]
  login -> recover [label="3"]
  signup -> login [label="1"]
  recover -> newpass [label="1",style=dashed]
  newpass -> login [label="1"]
}
