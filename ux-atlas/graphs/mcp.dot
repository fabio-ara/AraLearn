digraph G {
  graph [bgcolor="transparent", rankdir=LR, pad="0.23", nodesep="0.5", ranksep="0.8", splines="spline"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#bcc3cc", fontcolor="#30353c", fontname="Arial", fontsize=11.8, margin="0.15,0.09"];
  edge [color="#7b838d", fontcolor="#3346a8", fontname="Arial", fontsize=10, arrowsize=0.67];

  mcp_handoff [label="Preparar no AraLearn"];
  mcp_layout [label="Organizar telas"];
  mcp_authorize [label="Autorizar MCP"];
  mcp_read [label="Reler Curso"];
  mcp_deliberate [label="Debater decisão"];
  mcp_apply [label="Alterar Curso"];
  mcp_return [label="Conferir no AraLearn"];

  mcp_handoff -> mcp_layout [label="1", style=dashed, class="external"];
  mcp_layout -> mcp_authorize [label="1", style=dashed, class="external"];
  mcp_authorize -> mcp_read [label="1"];
  mcp_read -> mcp_deliberate [label="1"];
  mcp_deliberate -> mcp_apply [label="1"];
  mcp_apply -> mcp_return [label="1"];
}
