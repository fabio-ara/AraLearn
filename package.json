{
  "name": "aralearn",
  "version": "0.0.12",
  "private": true,
  "description": "Aplicativo de estudo offline em microssequências.",
  "type": "module",
  "scripts": {
    "start": "node ./scripts/servePublic.js",
    "dev": "node ./scripts/servePublic.js",
    "test": "node ./scripts/syncEdgeResourceRuntime.mjs --check && node ./scripts/runTests.mjs && node ./scripts/testAuthoringPackages.mjs && node ./scripts/testChatGptActionContract.mjs",
    "test:supabase:smoke": "node ./supabase/tests/postgrest-smoke.mjs",
    "test:authoring:smoke": "node ./supabase/tests/authoring-api-smoke.mjs",
    "test:authoring:mcp:local": "node ./supabase/tests/authoring-mcp-local-smoke.mjs",
    "test:authoring:mcp:hosted": "node ./supabase/tests/authoring-mcp-hosted-smoke.mjs",
    "test:authoring:mcp": "node --test ./tests/v4/authoring-mcp.test.js",
    "test:e2e": "node ./scripts/runE2eTests.mjs",
    "lint": "eslint .",
    "validate:example": "node ./scripts/validateExampleProject.js",
    "validate:cutover": "node ./scripts/validateRelationalCutover.mjs",
    "catalog:validate": "node ./scripts/publishCatalogFixtures.mjs --dry-run",
    "catalog:publish": "node ./scripts/publishCatalogFixtures.mjs --publish",
    "deployment:verify-hosted": "node ./scripts/verifyHostedBackend.mjs",
    "deployment:verify-site": "node ./scripts/verifyPublishedSite.mjs",
    "authoring:packages": "node ./scripts/buildAuthoringPackages.mjs",
    "resources:sync-edge": "node ./scripts/syncEdgeResourceRuntime.mjs",
    "authoring:access": "node ./scripts/manageAuthoringAccess.mjs",
    "test:authoring-packages": "node ./scripts/testAuthoringPackages.mjs && node ./scripts/testChatGptActionContract.mjs",
    "test:authoring-loop": "node ./scripts/testAuthoringStateLoop.mjs",
    "test:authoring-action": "node ./scripts/testChatGptActionContract.mjs",
    "validate:scope": "node ./src/generation/schemas/validateScopeContract.cli.js ./docs/examples/scope-contract.matematica-informatica.json",
    "harness:scope": "node ./scripts/runScopePlanningHarness.js",
    "harness:bottom-up": "node ./scripts/runBottomUpHarness.js",
    "smoke:deepseek:real": "node ./scripts/runDeepSeekRealSmoke.js",
    "smoke:deepseek:structured": "node ./scripts/runDeepSeekStructuredEngineSmoke.js",
    "benchmark:structured": "node ./scripts/runStructuredEngineBenchmark.js",
    "benchmark:topdown": "node ./scripts/runTopDownStructuredBenchmark.js",
    "benchmark:didactic": "node ./scripts/runDidacticQualityBenchmark.js",
    "resources:gallery:fixture": "node ./scripts/buildResourceGalleryFixture.mjs",
    "resources:gallery:visual": "node ./scripts/buildResourceGalleryFixture.mjs && node ./scripts/captureResourceGallery.mjs",
    "codex:local": "node ./scripts/aralearnCodexBridge.mjs",
    "android:debug": "pwsh -NoProfile -File ./scripts/buildAndroidDebug.ps1",
    "android:release": "pwsh -NoProfile -File ./scripts/buildAndroidRelease.ps1",
    "pages:build": "pwsh -NoProfile -File ./scripts/buildPages.ps1"
  },
  "dependencies": {
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.7.0",
    "espree": "^11.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "yaml": "^2.9.0"
  }
}
