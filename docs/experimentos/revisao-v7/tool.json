                      "introduced",
                      "established",
                      "revisited",
                      "preview",
                      "example",
                      "support",
                      "deferred"
                    ]
                  },
                  "motivo": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "ideias": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": [
                        "integer",
