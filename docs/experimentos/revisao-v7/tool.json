                    "minimum": 1,
                    "maximum": 512,
                    "description": "Escolha explícita quando a resposta devolver candidatos."
                  },
                  "prefixo": {
                    "type": "string",
                    "maxLength": 500,
                    "description": "Só para compatibilidade; o servidor deriva o contexto."
                  },
                  "sufixo": {
                    "type": "string",
                    "maxLength": 500,
                    "description": "Só para compatibilidade; o servidor deriva o contexto."
                  },
                  "papel": {
                    "type": "string",
