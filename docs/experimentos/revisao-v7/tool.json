        "minLength": 1,
        "maxLength": 300,
        "description": "Nome"
      },
      "parte": {
        "type": [
          "integer",
          "string"
        ],
        "minimum": 1,
        "maximum": 1000000,
        "minLength": 1,
        "maxLength": 300,
        "description": "Parte: posição ou título."
      },
      "microssequencia": {
        "type": [
          "integer",
          "string"
        ],
        "minimum": 1,
        "maximum": 1000000,
        "minLength": 1,
        "maxLength": 300,
        "description": "Microssequência por posição/título."
      },
      "explicacoes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "description": "Uma explicação previamente autorada por microssequência, compartilhada pelas unidades. Produzir não aprova conteúdo.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
