                "content": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "package",
                      "data"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Omita para gerar content-1, response-1, feedback-1 etc. Informe apenas quando referenciado por outro componente."
