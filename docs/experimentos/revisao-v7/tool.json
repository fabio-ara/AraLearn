                "type": "object",
                "additionalProperties": false,
                "required": [
                  "recurso",
                  "folha",
                  "papel",
                  "motivo",
                  "ideias",
                  "requisitos"
                ],
                "properties": {
                  "recurso": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "folha": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
