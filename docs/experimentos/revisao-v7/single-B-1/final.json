                    "0x100F",
                    "início + tamanho − 1"
                  ],
                  [
                    "próximo endereço",
                    "0x1010",
                    "fim + 1; não incluído"
                  ]
                ],
                "note": "Contar de 0x1000 até 0x100F inclui exatamente 16 endereços."
              }
            }
