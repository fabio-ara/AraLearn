              "title": "Lição experimental",
              "microsequences": [
                {
                  "title": "Modelo cascata",
                  "tags": ["Processos de software"],
                  "status": "ready",
                  "cards": [
                    {
                      "title": "Ideia central",
                      "say": "O modelo cascata organiza o trabalho em fases sequenciais.",
                      "after": "A ideia importante é reconhecer a ordem das fases antes de discutir exceções."
                    },
                    {
                      "title": "Leitura rápida",
                      "ask": "Qual estrutura agrupa cards no AraLearn?",
                      "answer": "Microssequência",
                      "wrong": ["Curso", "Módulo"]
                    },
                    {
                      "title": "Complete",
                      "say": "Todo card pertence a uma [[microssequência]].",
                      "wrong": ["lição", "módulo"]
                    },
                    {
                      "title": "Trecho de código",
                      "say": "O identificador abaixo aparece no topo do JSON.",
                      "language": "json",
                      "code": "{ \"contract\": \"aralearn.contract\" }"
                    },
                    {
                      "title": "Campos principais",
                      "table": {
                        "columns": ["Campo", "Uso"],
                        "rows": [
                          ["say", "Explicação ou lacuna textual"],
                          ["ask", "Pergunta de múltipla escolha"],
                          ["flow", "Fluxograma derivado pelo motor"]
                        ]
                      }
                    },
                    {
                      "title": "Fluxo básico",
                      "flow": [
                        { "start": "Ler" },
                        { "process": "Validar", "blank": true },
                        {
                          "if": "Está correto?",
                          "blank": { "target": "label", "key": "yes", "options": ["Sim", "Não"] },
                          "then": [{ "output": "Renderizar" }],
                          "else": [{ "process": "Revisar" }]
                        },
                        { "end": "Fim" }
                      ]
                    },
                    {
                      "title": "Árvore de diretórios",
                      "say": "A árvore mostra o diretório atual e alguns arquivos próximos.",
                      "tree": {
