{
  "contract": "aralearn.vertical-parity.v1",
  "purpose": "Registro de desenvolvimento que liga cada capacidade corrente de Curso às superfícies, transportes, persistência e provas que a tornam utilizável.",
  "policy": {
    "finalStage": "#130",
    "compatibilityInFinalState": false,
    "legacyAliasesInFinalState": false,
    "fallbacksInFinalState": false,
    "temporaryMigrationRequiresRemoval": true,
    "terminologyReview": "#116",
    "databaseInventoryPath": "docs/evidence/paridade-vertical-banco.v1.json"
  },
  "cases": [
    {
      "id": "study-course-experience",
      "intent": "Encontrar um Curso acessível, percorrer sua hierarquia, estudar suas unidades e conservar progresso, marcações de revisão e observações pessoais.",
      "classification": "ui",
      "status": "current",
      "terminologyReview": "#116",
      "objects": {
        "manifestFeatures": [
          "course-personal-state-v1"
        ],
        "databasePatterns": [
          "^table:(?:public\\.course_personal_states|private\\.course_personal_state_receipts)$",
          "^function:private\\.(?:valid_course_personal_state_v1|list_course_review_items_for_actor_v1)\\(.*\\)$",
          "^function:public\\.(?:list_course_review_items_v1|load_course_personal_state_v1|mutate_course_personal_state_v1)\\(.*\\)$"
        ]
      },
      "ui": [
        { "path": "src/ui/renderHomeScreen.js", "token": "data-action=\"open-course\"" },
        { "path": "src/ui/renderHomeScreen.js", "token": "data-action=\"open-review-item\"" },
        { "path": "src/study/CourseStudyScreen.js", "token": "data-action=\"open-observation\"" }
      ],
      "visibleEffects": [
        { "path": "src/study/CourseStudyApplication.js", "token": "renderCourseStudyScreen" },
        { "path": "src/ui/renderHomeScreen.js", "token": "data-action=\"reset-course-progress\"" }
      ],
      "persistence": [
        { "path": "src/persistence/CoursePersonalStateRepository.js", "token": "class CoursePersonalStateRepository" },
        { "path": "src/persistence/CourseLocalStore.js", "token": "class CourseLocalStore" }
      ],
      "routes": [
        { "path": "src/supabase/CourseApiClient.js", "token": "load_course_personal_state_v1" },
        { "path": "src/supabase/CourseApiClient.js", "token": "mutate_course_personal_state_v1" }
      ],
      "tests": [
        "tests/runtime/course-study-repository.test.js",
        "tests/runtime/course-personal-state-repository.test.js",
        "tests/e2e/course-study-cutover.spec.js"
      ],
      "justification": "O estado pessoal só é legítimo quando volta à experiência móvel de Estudo. Cache local, sincronização, CAS e idempotência são mecanismos internos dessa mesma capacidade, não produtos separados."
    },
    {
      "id": "course-authoring-experience",
      "intent": "Criar, localizar, planejar, inspecionar e alterar o mesmo Curso vivo pela Autoria visual ou pelo MCP.",
      "classification": "ui",
      "status": "current",
      "terminologyReview": "#116",
      "objects": {
        "mcpTools": [
          "listarCursos",
          "lerCurso",
          "criarCurso",
          "alterarCurso"
        ],
        "manifestFeatures": [
          "single-live-course-identity-v1",
          "paged-live-course-composition-v1",
          "course-cas-idempotency-v1",
          "course-instructional-plan-v1",
          "course-authoring-part-materialization-v1",
          "course-study-unit-inspection-v1"
        ],
        "databasePatterns": [
          "^table:(?:public\\.courses|private\\.course_entities|private\\.course_events|private\\.course_change_receipts|private\\.course_instructional_plans|private\\.course_instructional_plan_items|private\\.course_authoring_parts|private\\.course_authoring_part_didactic_microsequences|private\\.course_authoring_part_materializations|private\\.course_authoring_part_materialization_steps)$",
          "^function:private\\.(?:list_courses_for_actor_v1|get_course_for_actor_v1|list_course_entities_for_actor_v1|list_course_study_units_for_actor_v1|assert_course_lesson_dependencies_v1|course_instructional_plan_command_document_v1|course_authoring_part_progress_v1|get_course_instructional_plan_for_actor_v1|delete_course_authoring_relations_before_course_v1)\\(.*\\)$",
          "^function:public\\.(?:list_courses_v1|get_course_v1|list_course_entities_v1|list_courses_for_actor_v1|get_course_for_actor_v1|list_course_entities_for_actor_v1|create_course_for_actor_v1|commit_course_composition_for_actor_v1|commit_course_instructional_plan_for_actor_v1|advance_course_authoring_part_materialization_for_actor_v1|get_owned_course_instructional_plan_for_actor_v1|get_owned_course_instructional_plan_v1|get_owned_course_authoring_part_materialization_for_actor_v1|list_owned_course_study_units_for_actor_v1|list_owned_courses_for_actor_v1|get_owned_course_for_actor_v1|list_owned_course_entities_for_actor_v1|list_owned_courses_v1|get_owned_course_v1|list_owned_course_entities_v1)\\(.*\\)$"
        ]
      },
      "ui": [
        { "path": "src/ui/CourseAuthoringSurface.js", "token": "data-course-authoring-action=\"open-course\"" },
        { "path": "src/ui/CourseAuthoringSurface.js", "token": "data-course-authoring-create" },
        { "path": "src/ui/CourseAuthoringSurface.js", "token": "data-course-authoring-action=\"open-planning-edit\"" }
      ],
      "visibleEffects": [
        { "path": "src/ui/CourseAuthoringSurface.js", "token": "renderPlanningSection" },
        { "path": "src/ui/CourseInspectionSequence.js", "token": "createCourseInspectionSequence" },
        { "path": "src/ui/CourseAuthoringSurface.js", "token": "loadPartMaterialization" }
      ],
      "persistence": [
        { "path": "src/persistence/CourseLocalStore.js", "token": "class CourseLocalStore" },
        { "path": "src/supabase/CourseController.js", "token": "mutateAuthoringPlan" },
        { "path": "src/supabase/CourseController.js", "token": "loadAuthoringStudyUnits" },
        { "path": "src/supabase/CourseController.js", "token": "loadPartMaterialization" }
      ],
      "routes": [
        { "path": "supabase/functions/_shared/aralearn-authoring/courseMcpTools.js", "token": "mapAuthoringMcpToolCall" },
        { "path": "supabase/functions/_shared/aralearn-authoring/courseRouter.js", "token": "executeCourseRoute" }
      ],
      "tests": [
        "tests/runtime/course-mcp-tools.test.js",
        "tests/runtime/course-authoring-surface.test.js",
        "tests/runtime/course-inspection-sequence.test.js",
        "tests/runtime/course-controller.test.js",
        "tests/runtime/course-authoring-plan-pglite.test.js",
        "tests/e2e/course-authoring-cutover.spec.js"
      ],
      "justification": "A interface e o MCP operam a mesma identidade, versão e composição. Uma mutação por ferramenta só é completa quando a releitura a torna visível na Autoria."
    },
    {
      "id": "person-profile-and-course-access",
      "intent": "Manter um perfil humano mínimo e conceder ou revogar acesso direto ao Estudo de um Curso, sem papéis institucionais intermediários.",
      "classification": "ui",
      "status": "current",
      "terminologyReview": "#116",
      "objects": {
        "mcpTools": [
          "gerirPessoas"
        ],
        "manifestFeatures": [
          "direct-course-access-v1",
          "study-only-course-access-v1",
          "person-profile-v1",
          "private-person-avatar-v1",
          "self-account-deletion-v1"
        ],
        "databasePatterns": [
          "^table:(?:public\\.person_profiles|public\\.course_access)$",
          "^function:private\\.(?:course_ownership_v1|require_course_access_v1|can_read_person_v1|touch_person_profile_v1|create_person_profile_v1)\\(.*\\)$",
          "^function:public\\.(?:get_person_profile_for_actor_v1|update_person_profile_for_actor_v1|list_course_access_for_actor_v1|manage_course_access_for_actor_v1|delete_my_account_v1)\\(.*\\)$",
          "^bucket:storage\\.person-avatars$"
        ]
      },
      "ui": [
        { "path": "public/main.js", "token": "data-profile-form" },
        { "path": "src/ui/CourseAuthoringSurface.js", "token": "renderPeopleSection" },
        { "path": "src/ui/CourseAuthoringSurface.js", "token": "data-course-authoring-action=\"open-grant\"" }
      ],
      "visibleEffects": [
        { "path": "public/main.js", "token": "updatePersonProfile" },
        { "path": "src/ui/CourseAuthoringSurface.js", "token": "revokeCourseAccess" }
      ],
      "persistence": [
        { "path": "src/supabase/CourseApiClient.js", "token": "person-avatars" },
        { "path": "supabase/migrations/20260817150000_course_profiles_access.sql", "token": "create table public.person_profiles" }
      ],
      "routes": [
        { "path": "supabase/functions/_shared/aralearn-authoring/courseMcpTools.js", "token": "gerirPessoas" },
        { "path": "supabase/functions/_shared/aralearn-authoring/courseRouter.js", "token": "manageCourseAccess" }
      ],
      "tests": [
        "tests/runtime/course-mcp-tools.test.js",
        "tests/runtime/course-api-client.test.js",
        "tests/runtime/course-authoring-surface.test.js",
        "tests/runtime/course-controller.test.js"
      ],
      "justification": "Propriedade e compartilhamento são relações diretas. Perfil, avatar privado, acesso ao Estudo e exclusão da própria conta permanecem observáveis e não introduzem organizações, roles ou capabilities de produto."
    },
    {
      "id": "didactic-component-runtime",
      "intent": "Descobrir contratos de componentes didáticos progressivamente e renderizar no Estudo exatamente as composições validadas.",
      "classification": "ui",
      "status": "current",
      "terminologyReview": "#116",
      "objects": {
        "mcpTools": [
          "consultarComponentesDidaticos"
        ],
        "manifestFeatures": [
          "package-library-v1",
          "package-contract-discovery-v1"
        ],
        "databasePatterns": [
          "^function:public\\.get_aralearn_runtime_manifest\\(\\)$"
        ]
      },
      "ui": [
        { "path": "src/study/CourseStudyScreen.js", "token": "renderPackageStudyUnitBlocksWithDock" }
      ],
      "visibleEffects": [
        { "path": "src/study/CourseStudyScreen.js", "token": "renderPackageStudyUnitFeedback" }
      ],
      "persistence": [
        { "path": "src/resources/packages/generated.js", "token": "RESOURCE_PACKAGE_DEFINITIONS" }
      ],
      "routes": [
        { "path": "supabase/functions/_shared/aralearn-authoring/courseMcpTools.js", "token": "mapResourceLibrary" }
      ],
      "tests": [
        "tests/runtime/course-mcp-tools.test.js",
        "tests/runtime/package-study-rendering-regressions.test.js"
      ],
      "justification": "O catálogo modular só entrega valor se o contrato descoberto pelo MCP for o mesmo que o runtime valida e renderiza; a ferramenta não cria uma taxonomia paralela."
    },
    {
      "id": "course-shared-transports",
      "intent": "Expor as operações canônicas de Curso ao aplicativo e ao MCP autenticado sem duplicar domínio, estado ou ferramenta.",
      "classification": "mcp",
      "status": "current",
      "terminologyReview": "#116",
      "objects": {
        "edgeFunctions": [
          "aralearn-course-api",
          "aralearn-authoring-mcp"
        ],
        "manifestFeatures": [
          "flat-runtime-manifest-v1",
          "oauth-only-authoring-mcp"
        ],
        "databasePatterns": [
          "^function:private\\.(?:request_role|require_service_role)\\(\\)$",
          "^function:public\\.aralearn_mcp_access_token_hook\\(.*\\)$"
        ]
      },
      "routes": [
        { "path": "supabase/functions/_shared/aralearn-authoring/courseApiServer.js", "token": "createCourseApiHandler" },
        { "path": "supabase/functions/_shared/aralearn-authoring/mcpServer.js", "token": "createAuthoringMcpHandler" }
      ],
      "tests": [
        "tests/runtime/course-api-server.test.js",
        "tests/runtime/course-mcp-server.test.js",
        "tests/runtime/hosted-backend-verifier.test.js"
      ],
      "justification": "Os dois transportes adaptam o mesmo registry e executor de Curso. Não existe Action, ferramenta exclusiva do aplicativo nem segundo motor de autoria."
    },
    {
      "id": "pre-course-database-removal",
      "intent": "Isolar os objetos físicos do modelo substituído que ainda aguardam remoção definitiva em #130.",
      "classification": "remove",
      "status": "scheduled-removal",
      "removeBy": "#130",
      "objects": {
        "databaseInternalPatterns": [
          "^(?:table|view|materialized_view|function|bucket|index|constraint|trigger|policy|rls):.+$"
        ]
      },
      "tests": [
        "tests/runtime/vertical-parity-audit.test.js"
      ],
      "justification": "O seletor residual só recebe objetos sem vínculo com um caso corrente. Assim, o inventário conserva visibilidade do legado físico sem sobrepor Curso, estado pessoal, perfil, acesso, componentes didáticos ou OAuth."
    }
  ]
}
