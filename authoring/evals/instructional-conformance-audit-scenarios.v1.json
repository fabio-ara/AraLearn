      "title": "Parágrafo curto com excesso de unidades novas",
      "auditClass": "semantic_instructional",
      "runKind": "audit",
      "sourceIssue": 89,
      "scope": { "kind": "microsequence", "ref": "micro-dns-hierarchy" },
      "objective": "Explicar como o DNS organiza nomes e resolve registros, contrastando resolução com concessão de endereços por DHCP.",
      "analysis": {
        "newUnits": ["DNS", "hierarquia", "árvore", "base distribuída", "registro de recurso", "resolução", "DHCP"],
        "effectiveCeiling": 2
      },
      "materialization": {
        "targetPaths": [["course-network", "module-services", "lesson-dns", "micro-dns-hierarchy", "card-dns-dense"]],
        "cards": [
          {
            "id": "card-dns-dense",
            "role": "theory",
            "text": "O Domain Name System (DNS), ou Sistema de Nomes de Domínio, organiza nomes em um espaço hierárquico em árvore. Uma base distribuída de registros de recursos associa esses nomes a informações, e a resolução consulta essa estrutura; ela não aloca endereços por concessão.\nA hierarquia divide o espaço de nomes, enquanto registros distribuídos fornecem as informações consultadas durante a resolução."
          }
        ]
      },
      "expected": {
        "deterministicFindings": [],
        "semanticFindings": [
          {
            "code": "semantic_excessive_compression",
            "severity": "high",
            "target": { "entityType": "card", "entityPath": ["course-network", "module-services", "lesson-dns", "micro-dns-hierarchy", "card-dns-dense"], "resourceTargetId": null },
            "ruleRef": { "kind": "parameter", "id": "new_units_per_theory_step_ceiling", "version": "1.0.0" },
            "publicEvidence": "O único card coordena sete unidades novas sem desenvolver o percurso DNS, resolução e contraste com DHCP.",
            "proposedRepair": "Desenvolver progressivamente hierarquia, registros e resolução, com exemplo e contraste explícito com DHCP.",
            "humanJustifiable": true
          }
        ],
        "humanDecision": { "outcome": "approved", "repairAuthorized": true }
      },
      "repeatedSemanticRuns": [
        { "run": 1, "findingKeys": ["semantic_excessive_compression|card-dns-dense|new_units_per_theory_step_ceiling"] },
        { "run": 2, "findingKeys": ["semantic_excessive_compression|card-dns-dense|new_units_per_theory_step_ceiling"] },
        { "run": 3, "findingKeys": ["semantic_excessive_compression|card-dns-dense|new_units_per_theory_step_ceiling"] }
      ]
