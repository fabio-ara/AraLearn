{
  "contract": "aralearn.contract",
  "version": 4,
  "kind": "project",
  "courses": [
    {
      "id": "course-fixture-visual",
      "title": "Fixture Visual",
      "goal": "Validar recursos graph, matrix e plane no contrato v3.",
      "modules": [
        {
          "id": "module-fixture-visual",
          "title": "Visual",
          "guide": {
            "goal": "Cobrir recursos visuais simples.",
            "include": [
              "graph",
              "matrix",
              "plane"
            ],
            "exclude": [],
            "notation": [
              "Use rótulos curtos."
            ],
            "avoid": [
              "Não depender de contexto externo."
            ]
          },
          "lessons": [
            {
              "id": "lesson-fixture-visual",
              "title": "Visual",
              "guide": {
                "goal": "Ler um grafo, uma matriz e um vetor simples.",
                "include": [
                  "graph",
                  "matrix",
                  "plane"
                ],
                "exclude": [],
                "notation": [
                  "Use rótulos curtos."
                ],
                "avoid": [
                  "Não depender de contexto externo."
                ]
              },
              "topics": [],
              "microsequences": [
                {
                  "id": "micro-fixture-visual",
                  "title": "Recursos visuais",
                  "goal": "Reconhecer o elemento destacado.",
                  "role": "explain",
                  "status": "ready",
                  "dependsOn": [],
                  "covers": [
                    "graph",
                    "matrix",
                    "plane"
                  ],
                  "checks": [
                    "o aluno identifica o elemento destacado"
                  ],
                  "cards": [
                    {
                      "id": "card-fixture-visual-flow",
                      "position": 1,
                      "resource": "graph",
                      "kind": "theory",
                      "exercise": "none",
                      "title": "Grafo simples",
                      "prompt": "Observe o vértice destacado.",
                      "vertices": [
                        {
                          "id": "A",
                          "label": "A"
                        },
                        {
                          "id": "B",
                          "label": "B"
                        }
                      ],
                      "edges": [
                        {
                          "from": "A",
                          "to": "B",
                          "label": "liga",
                          "weight": "1",
                          "id": "edge-1"
                        }
                      ],
                      "highlight": {
                        "vertices": [
                          "A"
                        ],
                        "edges": [
                          "edge-1"
                        ]
                      },
                      "after": "O vértice `A` está ligado a `B`.",
                      "layout": "path"
                    },
                    {
                      "id": "card-fixture-visual-graph",
                      "position": 2,
                      "resource": "matrix",
                      "kind": "theory",
                      "exercise": "none",
                      "title": "Matriz identidade",
                      "prompt": "Observe a diagonal principal.",
                      "values": [
                        [
                          "1",
                          "0"
                        ],
                        [
                          "0",
                          "1"
                        ]
                      ],
                      "after": "A diagonal principal fica com `1`."
                    },
                    {
                      "id": "card-fixture-visual-relation-map",
                      "position": 3,
                      "resource": "plane",
                      "kind": "theory",
                      "exercise": "none",
                      "title": "Vetor no plano",
                      "prompt": "Observe o vetor v.",
                      "vector": [
                        2,
                        1
                      ],
                      "after": "O vetor aponta para `(2, 1)`."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
