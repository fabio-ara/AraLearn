{
  "id": "course-fixture-formulas",
  "title": "Fórmulas matemáticas e químicas",
  "goal": "Validar fórmulas estruturadas no contrato AraLearn v3.",
  "modules": [
    {
      "id": "module-fixture-formulas",
      "title": "Notação",
      "guide": {
        "goal": "Representar fórmulas com estrutura e leitura acessível.",
        "include": [
          "fração",
          "raiz",
          "fórmula química"
        ],
        "exclude": [],
        "notation": [
          "Use símbolos Unicode na AST de fórmula."
        ],
        "avoid": [
          "Não inserir HTML, MathML ou LaTeX no conteúdo."
        ]
      },
      "lessons": [
        {
          "id": "lesson-fixture-formulas",
          "title": "Expressões estruturadas",
          "guide": {
            "goal": "Ler fórmulas matemáticas e químicas sem depender de marcação fornecida pelo autor.",
            "include": [
              "estrutura da expressão",
              "leitura textual"
            ],
            "exclude": [],
            "notation": [
              "Use mathematics ou chemistry."
            ],
            "avoid": [
              "Não depender de imagem para comunicar a fórmula."
            ]
          },
          "topics": [],
          "microsequences": [
            {
              "id": "micro-fixture-formulas",
              "title": "Fórmulas",
              "goal": "Reconhecer a estrutura de uma expressão e sua leitura.",
              "role": "explain",
              "status": "ready",
              "dependsOn": [],
              "covers": [
                "fórmula matemática",
                "fórmula química"
              ],
              "checks": [
                "o estudante relaciona a apresentação visual à leitura textual"
              ],
              "cards": [
                {
                  "id": "card-formula-matematica",
                  "position": 1,
                  "resource": "formula",
                  "kind": "theory",
                  "exercise": "none",
                  "title": "Fração e raiz",
                  "prompt": "Observe a estrutura da igualdade.",
                  "notation": "mathematics",
                  "accessibleText": "x é igual a um dividido pela raiz cúbica de y.",
                  "expression": {
                    "type": "row",
                    "children": [
                      {
                        "type": "identifier",
                        "value": "x"
                      },
                      {
                        "type": "operator",
                        "value": "="
                      },
                      {
                        "type": "fraction",
                        "numerator": {
                          "type": "number",
                          "value": "1"
                        },
                        "denominator": {
                          "type": "root",
                          "radicand": {
                            "type": "identifier",
                            "value": "y"
                          },
                          "index": {
                            "type": "number",
                            "value": "3"
                          }
                        }
                      }
                    ]
                  },
                  "after": "A AST preserva a relação entre numerador, denominador, radicando e índice."
                },
                {
                  "id": "card-formula-quimica",
                  "position": 2,
                  "resource": "formula",
                  "kind": "theory",
                  "exercise": "none",
                  "title": "Água",
                  "prompt": "Observe a posição do índice.",
                  "notation": "chemistry",
                  "accessibleText": "H dois O.",
                  "expression": {
                    "type": "row",
                    "children": [
                      {
                        "type": "subscript",
                        "base": {
                          "type": "identifier",
                          "value": "H"
                        },
                        "subscript": {
                          "type": "number",
                          "value": "2"
                        }
                      },
                      {
                        "type": "identifier",
                        "value": "O"
                      }
                    ]
                  },
                  "after": "O índice 2 se aplica ao hidrogênio."
                },
                {
                  "id": "card-formula-escolha",
                  "position": 3,
                  "resource": "formula",
                  "kind": "exercise",
                  "exercise": "choice",
                  "title": "Leia a potência",
                  "prompt": "Observe a expressão.",
                  "notation": "mathematics",
                  "accessibleText": "alfa ao quadrado.",
                  "expression": {
                    "type": "superscript",
                    "base": {
                      "type": "identifier",
                      "value": "α"
                    },
                    "exponent": {
                      "type": "number",
                      "value": "2"
                    }
                  },
                  "question": "Qual descrição corresponde à expressão mostrada?",
                  "options": [
                    {
                      "id": "a",
                      "text": "alfa ao quadrado"
                    },
                    {
                      "id": "b",
                      "text": "alfa dividido por dois"
                    },
                    {
                      "id": "c",
                      "text": "raiz quadrada de alfa"
                    }
                  ],
                  "answer": "a",
                  "after": "O expoente aparece acima e à direita da base."
                },
                {
                  "id": "card-formula-composta",
                  "position": 4,
                  "resource": "composite",
                  "kind": "theory",
                  "exercise": "none",
                  "title": "Fórmula no contexto",
                  "blocks": [
                    {
                      "kind": "paragraph",
                      "value": "A igualdade pode aparecer junto de uma explicação."
                    },
                    {
                      "kind": "formula",
                      "prompt": "Observe os delimitadores.",
                      "notation": "mathematics",
                      "accessibleText": "abre parêntese, beta mais um, fecha parêntese.",
                      "expression": {
                        "type": "fenced",
                        "open": "(",
                        "close": ")",
                        "content": {
                          "type": "row",
                          "children": [
                            {
                              "type": "identifier",
                              "value": "β"
                            },
                            {
                              "type": "operator",
                              "value": "+"
                            },
                            {
                              "type": "number",
                              "value": "1"
                            }
                          ]
                        }
                      }
                    }
                  ],
                  "after": "O bloco de fórmula continua granular dentro do card composto."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
