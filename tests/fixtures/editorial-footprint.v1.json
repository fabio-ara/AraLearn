      "studyUnit": {
        "id": "footprint-code-long",
        "position": 4,
        "title": "Busca binária instrumentada",
        "role": "theory",
        "content": [
          {
            "id": "code-long-content",
            "package": "aralearn.resource.code",
            "version": "1.0.0",
            "data": {
              "prompt": "Acompanhe como os limites reduzem o intervalo e como cada tentativa é registrada.",
              "language": "python",
              "code": "def busca_binaria(valores, alvo):\n    inicio = 0\n    fim = len(valores) - 1\n    tentativas = []\n\n    while inicio <= fim:\n        meio = (inicio + fim) // 2\n        atual = valores[meio]\n        tentativas.append({\n            'inicio': inicio,\n            'fim': fim,\n            'meio': meio,\n            'valor': atual,\n        })\n\n        if atual == alvo:\n            return meio, tentativas\n        if atual < alvo:\n            inicio = meio + 1\n        else:\n            fim = meio - 1\n\n    return None, tentativas"
            }
          }
        ],
        "response": null,
